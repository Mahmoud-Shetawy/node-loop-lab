{
	"name": "node-loop-lab",
	"version": "1.0.0",
	"description": "Step through the Node.js event loop: V8, libuv phases, nextTick and Promise queues, timers and the thread pool.",
	"author": "Mahmoud Shetawy",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource/ibm-plex-sans-arabic": "^5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"ace-builds": "^1.44.0",
		"acorn": "^8.18.0",
		"acorn-walk": "^8.3.5",
		"astring": "^1.9.0",
		"clsx": "^2.1.1",
		"eslint-scope": "^9.1.2",
		"lucide-react": "^1.30.0",
		"motion": "13.5.1",
		"react": "^19.2.8",
		"react-ace": "^15.0.0",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/estree": "^1.0.9",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"eslint": "^10.8.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
